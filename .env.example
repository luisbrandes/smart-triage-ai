# Somente desenvolvimento local. Produção deve usar credenciais próprias e seguras.
# Nunca versione credenciais reais nem exponha esta variável com prefixo NEXT_PUBLIC_.
DATABASE_URL="postgresql://smart_triage:smart_triage_local@localhost:5432/smart_triage?schema=public"
DIRECT_DATABASE_URL="postgresql://smart_triage:smart_triage_local@localhost:5432/smart_triage?schema=public"
# Banco PostgreSQL isolado para testes de integração; nunca use o banco de produção.
TEST_DATABASE_URL="postgresql://smart_triage_test:smart_triage_test@localhost:5433/smart_triage_test?schema=public"

# Use "demo" para habilitar regras demonstrativas. O valor "production" bloqueia o motor V0.
APP_MODE="demo"

# Senha única compartilhada pelos dois painéis.
ACCESS_CREDENTIAL="defina-a-senha-de-acesso"

# Configurações internas do servidor. Gere valores próprios em cada ambiente.
SESSION_SECRET="gere-uma-chave-aleatoria-com-no-minimo-32-caracteres"
NURSE_ACTOR_REFERENCE="identificador-generico-da-enfermagem"

# Dispositivo usado pelo fluxo web. O identificador não é segredo.
TRIAGE_DEVICE_ID="ESP32-001"

# Segredo server-only usado para derivar hashes dos tokens dos dispositivos.
# Gere um valor aleatório com no mínimo 32 caracteres; nunca use prefixo NEXT_PUBLIC_.
DEVICE_TOKEN_PEPPER="gere-uma-chave-aleatoria-com-no-minimo-32-caracteres"

# Opcional: sugestão experimental acionada pela enfermagem, somente em APP_MODE=demo.
# Server-only; configure também no ambiente de implantação. Nunca use NEXT_PUBLIC_ nem versione a chave real.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
