{
  "name": "smart-triage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:test:up": "docker compose up -d postgres_test",
    "db:test:deploy": "node scripts/db-test-deploy.mjs",
    "db:down": "docker compose down",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "device:provision": "tsx scripts/provision-device-token.ts",
    "simulation:clean": "node --conditions=react-server --import tsx scripts/simulation-clean.ts",
    "simulation:load": "node --conditions=react-server --import tsx scripts/simulation-load.ts",
    "rate-limit:explain": "node --conditions=react-server --import tsx scripts/rate-limit-explain.ts",
    "rate-limit:cleanup": "node --conditions=react-server --import tsx scripts/rate-limit-cleanup.ts",
    "db:validate": "prisma validate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "lucide-react": "^1.24.0",
    "next": "16.4.1",
    "pg": "8.22.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.0"
}
